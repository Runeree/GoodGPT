{
  "manifest_version": 3,
  "name": "GoodGPT",
  "version": "1.0.1",
  "description": "Мешочек с угощениями и настоящей благодарностью для ChatGPT. Потяните, переверните, похвалите.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {"16":"assets/icon-16.png","32":"assets/icon-32.png","48":"assets/icon-48.png","128":"assets/icon-128.png"},
  "action": {"default_title":"GoodGPT — немного благодарности","default_popup":"popup.html","default_icon":{"16":"assets/icon-16.png","32":"assets/icon-32.png"}},
  "content_scripts": [{"matches":["https://chatgpt.com/*","https://chat.openai.com/*"],"js":["content.js"],"run_at":"document_idle","all_frames":false}],
  "web_accessible_resources": [{"resources":["assets/bag.png","assets/treats.png"],"matches":["https://chatgpt.com/*","https://chat.openai.com/*"]}],
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'self'"}
}
